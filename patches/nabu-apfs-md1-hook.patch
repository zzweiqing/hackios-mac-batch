+#if XNU_NABU_APFS_MD1
+volatile int mdev_apfs_iomedia_status = -1;
+volatile uint32_t mdev_apfs_iomedia_count;
+
+/* The existing mdev bdevsw owns I/O and devfs. IOMedia supplies its real identity
+ * to APFS; its BSD client category is owned before synchronous publication. */
+static int
+mdev_apfs_publish_media(int slot, const char *name, uint64_t bytes)
+{
+	dev_t device = mdevlookup(slot);
+	if (device == (dev_t)-1 || !bytes) {
+		return ENXIO;
+	}
+	OSObject *object = OSMetaClass::allocClassWithName("IOMedia");
+	IOService *service = OSDynamicCast(IOService, object);
+	if (!service || !service->metaCast("IOMedia")) {
+		OSSafeReleaseNULL(object);
+		return ENODEV;
+	}
+	IOMedia *media = static_cast<IOMedia *>(service);
+	if (!media->init(0, bytes, 4096, 0, false, false, "")) {
+		media->release();
+		return ENOMEM;
+	}
+	media->setName(name);
+	bool properties = media->setProperty(kIOBSDNameKey, name) &&
+	    media->setProperty(kIOBSDMajorKey, (uint64_t)((uint32_t)device >> 24), 32) &&
+	    media->setProperty(kIOBSDMinorKey, (uint64_t)((uint32_t)device & 0xffffff), 32);
+	IOService *provider = IOService::getResourceService();
+	if (!properties || !provider || !media->attach(provider)) {
+		media->release();
+		return ENOMEM;
+	}
+	IOService *client = new IOService;
+	const OSSymbol *category = OSSymbol::withCStringNoCopy("IOMediaBSDClient");
+	bool initialized = client && client->init();
+	bool attached = initialized && category &&
+	    client->setProperty(kIOMatchCategoryKey, category) && client->attach(media);
+	OSSafeReleaseNULL(category);
+	if (!attached) {
+		OSSafeReleaseNULL(client);
+		media->detach(provider);
+		media->release();
+		return ENOMEM;
+	}
+	client->setName("HackiosMdevBSDOwner");
+	media->registerService(kIOServiceSynchronous);
+	bool matched = (media->getState() & kIOServiceMatchedState) != 0;
+	OSNumber *majorValue = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
+	OSNumber *minorValue = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
+	bool identity = majorValue && minorValue &&
+	    majorValue->unsigned32BitValue() == ((uint32_t)device >> 24) &&
+	    minorValue->unsigned32BitValue() == ((uint32_t)device & 0xffffff);
+	if (matched && identity) {
+		mdev_apfs_iomedia_count++;
+	}
+	IOLog("APFS mdev IOMedia %s dev=%x matched=%d identity=%d\n",
+	    name, (unsigned int)device, matched, identity);
+	/* Attached objects remain owned by the registry until reboot. */
+	client->release();
+	media->release();
+	return matched && identity ? 0 : EIO;
+}
 #endif
 
