--- a/bsd/dev/memdev.c
+++ b/bsd/dev/memdev.c
@@ -85,6 +85,11 @@
 
 #include <sys/conf.h>
 
+#if XNU_NABU_APFS_MD1
+#include <sys/buf.h>
+#include <sys/errno.h>
+#endif
+
 /*
