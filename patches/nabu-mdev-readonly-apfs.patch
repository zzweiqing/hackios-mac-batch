+#if XNU_NABU_APFS_MD1
+/* Called only during IOFindBSDRoot, before userspace can open the new nodes. */
+int
+mdev_apfs_md1_register(uint64_t offset, uint64_t size)
+{
+	uint64_t base, capacity;
+	dev_t device, device2;
+	if (mdev_apfs_md1_ready || (mdev[1].mdFlags & mdInited) ||
+	    (mdev[2].mdFlags & mdInited)) {
+		return EBUSY;
+	}
+	if (offset == 0 || size == 0 || size >= (64ULL << 20) ||
+	    (offset & 4095) || (size & 4095) ||
+	    mdevgetrange(0, &base, &capacity) || (mdev[0].mdFlags & mdPhys) ||
+	    offset > capacity || size > capacity - offset) {
+		return EINVAL;
+	}
+	/* Explicit slots permit aliases; all bounds derive from the actual md0 KVA. */
+	device = mdevadd(1, (base + offset) >> 12, (unsigned int)(size >> 12), 0);
+	if (device == (dev_t)-1) {
+		return ENODEV;
+	}
+	mdev[1].mdFlags |= mdRO;
+	mdev_apfs_s1_alias_slot = 2;
+	device2 = mdevadd(2, (base + offset) >> 12, (unsigned int)(size >> 12), 0);
+	mdev_apfs_s1_alias_slot = -1;
+	if (device2 == (dev_t)-1 || device2 == device || minor(device2) != 2) {
+		return ENODEV;
+	}
+	mdev[2].mdFlags |= mdRO;
+	mdev_apfs_md1s1_bdev = device2;
+	mdev_apfs_md1_capacity_bytes = size;
+	mdev_apfs_md1_ready = 1;
+	return 0;
+}
+#endif
