@@ -0,0 +1,36 @@
+pub fn answer(reported: Option<u64>, vendor_id: u32, device_id: u32) -> Option<u64> {
+    reported.filter(|count| *count > 0).or_else(|| {
+        (vendor_id == 0x5143 && device_id == 0x06040001).then_some(2)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::answer;
+
+    #[test]
+    fn exact_a640_identity() {
+        assert_eq!(answer(None, 0x5143, 0x06040001), Some(2));
+        assert_eq!(answer(Some(0), 0x5143, 0x06040001), Some(2));
+    }
+
+    #[test]
+    fn wrong_vendor_is_unknown() {
+        assert_eq!(answer(None, 0x13b5, 0x06040001), None);
+        assert_eq!(answer(Some(0), 0x13b5, 0x06040001), None);
+    }
+
+    #[test]
+    fn wrong_chip_is_unknown() {
+        for device_id in [0x06040000, 0x06030500, 0x07040001, 0] {
+            assert_eq!(answer(None, 0x5143, device_id), None);
+        }
+    }
+
+    #[test]
+    fn reported_answer_has_priority() {
+        assert_eq!(answer(Some(7), 0x5143, 0x06040001), Some(7));
+        assert_eq!(answer(Some(11), 0x13b5, 0x06040001), Some(11));
+        assert_eq!(answer(Some(13), 0x5143, 0x07040001), Some(13));
+    }
+}
