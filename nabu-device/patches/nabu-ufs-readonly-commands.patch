-// Read `blocks` (<= kDataMax / 4096) 4096-byte blocks of LUN `lun` starting at `lba` into dst.
+// READ CAPACITY(10) for LUN 0. The caller validates the 4096-byte logical block
+// size and installs the returned count in gHost.blocks before enabling reads.
+// The UINT32_MAX last-LBA sentinel requires READ CAPACITY(16), which this profile
+// deliberately does not claim to support.
+static IOReturn hostReadCapacity4k (uint64_t *blocks)
+{
+  if (!blocks || !gHost.virt || !gHost.lock) return kIOReturnBadArgument;
+  if (gHost.poisoned) return kIOReturnNotReady;
+  IOLockLock (gHost.lock);
+  uint8_t cdb[10] = { kScsiReadCapacity10 };
+  uint32_t scsi = 0;
+  IOReturn status = hostScsi (0, cdb, 10, true, 8, 1000000, &scsi);
+  if (status == kIOReturnSuccess) {
+    const uint8_t *data = gHost.virt + kDataOffset;
+    uint32_t lastLba = loadBe32 (data);
+    uint32_t blockBytes = loadBe32 (data + 4);
+    if (lastLba == 0xffffffffU || blockBytes != kLogicalBlockBytes) status = kIOReturnUnsupported;
+    else *blocks = uint64_t (lastLba) + 1;
+  }
+  IOLockUnlock (gHost.lock);
+  return status;
+}
