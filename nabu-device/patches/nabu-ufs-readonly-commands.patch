+static uint32_t loadBe16 (const uint8_t *at)
+{
+  return (uint32_t (at[0]) << 8) | at[1];
+}
+
+enum : uint8_t {
+  kScsiTestUnitReady = 0x00,
+  kScsiReadCapacity10 = 0x25,
+  kScsiRead10 = 0x28,
+};
+
+enum : uint32_t { kLogicalBlockBytes = 4096 };
