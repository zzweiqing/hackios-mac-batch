+// The board profile exposes only these three SCSI commands. Validate every
+// caller-controlled field before hostClearUcd performs DMA writes or reads MMIO.
+static IOReturn hostValidateScsiCommand (uint8_t lun, const uint8_t *cdb, unsigned cdbLength,
+                                         unsigned direction, uint32_t dataBytes)
+{
+  if (!cdb || !cdbLength || cdbLength > 16 || lun != 0) return kIOReturnBadArgument;
+  if (direction == 1) return kIOReturnNotPermitted;
+  switch (cdb[0]) {
+    case kScsiTestUnitReady:
+      if (cdbLength != 6 || direction != 0 || dataBytes) return kIOReturnBadArgument;
+      for (unsigned index = 1; index < 6; index++) if (cdb[index]) return kIOReturnBadArgument;
+      return kIOReturnSuccess;
+    case kScsiReadCapacity10:
+      if (cdbLength != 10 || direction != 2 || dataBytes != 8) return kIOReturnBadArgument;
+      for (unsigned index = 1; index < 10; index++) if (cdb[index]) return kIOReturnBadArgument;
+      return kIOReturnSuccess;
+    case kScsiRead10: {
+      if (cdbLength != 10 || direction != 2) return kIOReturnBadArgument;
+      uint32_t transferBlocks = loadBe16 (cdb + 7);
+      if (!transferBlocks || dataBytes != transferBlocks * kLogicalBlockBytes ||
+          dataBytes > kDataMax || cdb[1] || cdb[6] || cdb[9]) return kIOReturnBadArgument;
+      uint64_t lba = loadBe32(cdb + 2);
+      if (!gHost.blocks || lba >= gHost.blocks || transferBlocks > gHost.blocks - lba ||
+          transferBlocks > 0x100000000ULL - lba) return kIOReturnBadArgument;
+      if (!gHost.ready || gHost.poisoned) return kIOReturnNotReady;
+      return kIOReturnSuccess;
+    }
+    default:
+      return kIOReturnNotPermitted;
+  }
+}
+
+// A Command UPIU always carries a 16-byte CDB area, including zero padding after
+// a 6- or 10-byte command. Keep this second gate before any submission-side I/O.
+static IOReturn hostValidateScsiUcd (const uint8_t *ucd, uint32_t direction, uint32_t dataBytes)
+{
+  if (ucd[0] == 0) {
+    if (direction || dataBytes || ucd[1] || ucd[2] || ucd[3] != 1) return kIOReturnBadArgument;
+    for (unsigned i = 4; i < 32; ++i) if (ucd[i]) return kIOReturnBadArgument;
+    return kIOReturnSuccess;
+  }
+  if (ucd[0] == 0x16) {
+    if (direction || dataBytes || ucd[1] || ucd[2] || ucd[3] != 1 || ucd[4] ||
+        ucd[5] != 1 || (ucd[12] != 3 && ucd[12] != 5)) return kIOReturnNotPermitted;
+    for (unsigned i = 6; i < 12; ++i) if (ucd[i]) return kIOReturnBadArgument;
+    for (unsigned i = 14; i < 32; ++i) if (ucd[i]) return kIOReturnBadArgument;
+    return kIOReturnSuccess;
+  }
+  if (ucd[0] != 0x01) return kIOReturnNotPermitted;
+  if (ucd[1] != (direction == 2 ? 0x40 : 0) || ucd[3] ||
+      loadBe32(ucd + 12) != dataBytes) return kIOReturnBadArgument;
+  for (unsigned i = 4; i < 12; ++i) if (ucd[i]) return kIOReturnBadArgument;
+  if (direction == 1) return kIOReturnNotPermitted;
+  const uint8_t *cdb = ucd + 16;
+  unsigned cdbLength = 0;
+  switch (cdb[0]) {
+    case kScsiTestUnitReady:
+      cdbLength = 6;
+      for (unsigned index = 6; index < 16; index++) if (cdb[index]) return kIOReturnBadArgument;
+      break;
+    case kScsiReadCapacity10:
+      cdbLength = 10;
+      for (unsigned index = 10; index < 16; index++) if (cdb[index]) return kIOReturnBadArgument;
+      break;
+    case kScsiRead10:
+      cdbLength = 10;
+      for (unsigned index = 10; index < 16; index++) if (cdb[index]) return kIOReturnBadArgument;
+      break;
+    default:
+      return kIOReturnNotPermitted;
+  }
+  return hostValidateScsiCommand (ucd[2], cdb, cdbLength, direction, dataBytes);
+}
