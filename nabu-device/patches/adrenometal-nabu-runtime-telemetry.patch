+/// Six process-wide words, scheduled then completed, each count, settle us and post-settlement us.
+/// This reads the runtime's atomic counters without forcing lowering or taking a device lock.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_runtime_wait_phase_stats(out: *mut u64) -> bool {
+    guard(false, || {
+        if out.is_null() {
+            return Err("null runtime wait phase stats".into());
+        }
+        let counts = CommandBuffer::wait_phase_counts();
+        // SAFETY: the header requires six writable words.
+        unsafe { std::slice::from_raw_parts_mut(out, counts.len()) }.copy_from_slice(&counts);
         Ok(true)
     })
 }
 
