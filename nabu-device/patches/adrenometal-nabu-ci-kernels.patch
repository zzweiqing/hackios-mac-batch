+// nabu: Core Image's Metal path asks the device for its precompiled kernels (externFunctionNames) and stitches them through the system's
+// Metal compiler (request 14). Both are needed together: without the names Core Image builds a null DAG program, and without stitching the
+// kernels are never made. The image's marker beside the bundle ("ci-kernels=0") turns the path off for a comparison run; every other image
+// keeps it on.
+static bool nabuGpuCiKernelsEnabled() {
+ static bool enabled;static dispatch_once_t once;
+ dispatch_once(&once,^{
+  enabled=true;
+  Dl_info info={};
+  if(!dladdr((const void *)&nabuGpuCiKernelsEnabled,&info) || !info.dli_fname)return;
+  char path[1024];
+  if(snprintf(path,sizeof path,"%s",info.dli_fname)<=0)return;
+  char *slash=strrchr(path,'/');if(!slash)return;*slash=0;   // <dir>/NativeAdrenoMetal.bundle/NativeAdrenoMetal
+  slash=strrchr(path,'/');if(!slash)return;
+  snprintf(slash+1,sizeof path-(size_t)(slash+1-path),"NativeAdrenoMetal.publish");
+  FILE *file=fopen(path,"rb");if(!file)return;
+  char text[32]={};const size_t length=fread(text,1,sizeof text-1,file);fclose(file);
+  text[length]=0;
+  if(strstr(text,"ci-kernels=0"))enabled=false;
+ });
+ return enabled;
+}
