@@ -35,15 +36,31 @@
         target_ = [device newBufferWithBytesNoCopy:scanout.base length:scanout.bytes options:MTLResourceStorageModeShared deallocator:nil];
     }
     bool ready() const { return target_ != nil; }
+    uint64_t sourceImports() const { return sources_.imports(); }
+    uint64_t sourceHits() const { return sources_.hits(); }
     // One frame: encodes the GPU copy, commits, waits for the GPU. Rows are copied as whole rows of width*4 bytes.
-    Result present(const Frame &frame) {
+    Result present(const Frame &frame, uint32_t sourceSlot = 0) {
         if (!ready()) return kBadScanout;
         const size_t page = (size_t)getpagesize(), row = (size_t)frame.width * 4;
         if (!frame.base || ((uintptr_t)frame.base & (page - 1)) || !frame.bytes || (frame.bytes & (page - 1)) ||
             frame.width != scanout_.width || frame.height != scanout_.height || frame.stride < row ||
             (size_t)frame.height > frame.bytes / frame.stride || frame.stride * (frame.height - 1) + row > frame.bytes) return kBadFrame;
-        id<MTLBuffer> source = [device_ newBufferWithBytesNoCopy:(void *)frame.base length:frame.bytes options:MTLResourceStorageModeShared deallocator:nil];
-        if (!source) return kNoResource;
+        // Only a kernel slot may skip a new import: its map is retained until reboot.
+        // A generic caller (slot 0) keeps the original no-copy import semantics.
+        const auto match = sourceSlot ? sources_.match(sourceSlot, frame.base, frame.bytes) : nabu_scanout::SourceCache::Empty;
+        if (match == nabu_scanout::SourceCache::Invalid) return kBadFrame;
+        id<MTLBuffer> source = nil;
+        if (sourceSlot && match == nabu_scanout::SourceCache::Same) {
+            source = heldSources_[sourceSlot - 1];
+            if (!source || !sources_.reused(sourceSlot, frame.base, frame.bytes)) return kBadFrame;
+        } else {
+            source = [device_ newBufferWithBytesNoCopy:(void *)frame.base length:frame.bytes options:MTLResourceStorageModeShared deallocator:nil];
+            if (!source) return kNoResource;
+            if (sourceSlot) {
+                if (!sources_.imported(sourceSlot, frame.base, frame.bytes)) return kBadFrame;
+                heldSources_[sourceSlot - 1] = source;
+            }
+        }
         id<MTLCommandBuffer> commands = [queue_ commandBuffer];
         id<MTLBlitCommandEncoder> blit = commands ? [commands blitCommandEncoder] : nil;
         if (!blit) return kNoResource;
@@ -83,6 +100,8 @@
     Scanout scanout_;
     id<MTLCommandQueue> queue_;
     id<MTLBuffer> target_;
+    nabu_scanout::SourceCache sources_;
+    id<MTLBuffer> __strong heldSources_[nabu_scanout::SourceCache::Slots] = {};
 };
 
 }  // namespace gpupresent
