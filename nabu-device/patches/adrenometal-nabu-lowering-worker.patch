 namespace publish {
+// Lowering Worker is an experiment: only the render server may opt in, and only
+// when the boot argument can actually be read and contains the exact token
+// "nabu-metal-worker=1". The child processes inherit this environment from
+// launchd, so forcing it to 1/0 here for every process is part of the contract.
+enum LoweringGate : unsigned {
+    LoweringGateUnset = 0,
+    LoweringGateOtherProcess = 1,
+    LoweringGateReadFailed = 2,
+    LoweringGateTooLarge = 3,
+    LoweringGateDisabled = 4,
+    LoweringGateEnabled = 5,
+};
+static unsigned loweringBootArg() {
+    constexpr size_t capacity = 4096;
+    size_t size = 0;
+    if (sysctlbyname("kern.bootargs", nullptr, &size, nullptr, 0) || !size)
+        return LoweringGateReadFailed;
+    if (size > capacity)
+        return LoweringGateTooLarge;
+    char text[capacity] = {};
+    if (sysctlbyname("kern.bootargs", text, &size, nullptr, 0))
+        return LoweringGateReadFailed;
+    text[capacity - 1] = 0;
+    for (char *save = nullptr, *token = strtok_r(text, " \t\r\n", &save);
+         token; token = strtok_r(nullptr, " \t\r\n", &save))
+        if (!strcmp(token, "nabu-metal-worker=1"))
+            return LoweringGateEnabled;
+    return LoweringGateDisabled;
+}
+static void selectLoweringWorker() {
+    const unsigned status = strcmp(getprogname(), "backboardd") == 0 ?
+        loweringBootArg() : LoweringGateOtherProcess;
+    setenv("NABU_METAL_LOWERING_STATUS", status == 5 ? "5" :
+           status == 4 ? "4" : status == 3 ? "3" : status == 2 ? "2" : "1", 1);
+    setenv("NABU_METAL_LOWERING_WORKER", status == 5 ? "1" : "0", 1);
+}
