@@ -120,4 +120,20 @@
 /// # Safety
 /// `loader` and `cache` are C strings.
+unsafe extern "C" {
+    fn getprogname() -> *const c_char;
+}
+fn lowering_worker_enabled() -> bool {
+    fn is(name: &str, value: &str) -> bool {
+        std::env::var_os(name).is_some_and(|v| v == std::ffi::OsStr::new(value))
+    }
+    if !is("NABU_METAL_LOWERING_WORKER", "1") || !is("NABU_METAL_LOWERING_STATUS", "5") {
+        return false;
+    }
+    // Defense in depth if this environment is ever supplied outside the plugin:
+    // only the render server may select Worker.
+    let name = unsafe { getprogname() };
+    !name.is_null() && unsafe { CStr::from_ptr(name) }.to_bytes() == b"backboardd"
+}
